{
  "version": 2,
  "buildCommand": "pnpm run build",
  "devCommand": "pnpm run dev",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "regions": [
    "bom1"
  ],
  "crons": [
    {
      "path": "/api/career-tracks/cron/task-reminder",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/jobs/skill-sync",
      "schedule": "0 2 1 * *"
    },
    {
      "path": "/api/jobs/refresh",
      "schedule": "0 3 * * *"
    }
  ]
}